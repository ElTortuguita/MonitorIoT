<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF4F4"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tvTituloMonitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Monitor IoT"
            android:textColor="#00695C"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvConexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Conectando a MQTT..."
            android:textColor="#F57C00"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvSincronizacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Nube: preparando sincronizacion..."
            android:textColor="#F57C00"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvEtiquetaTemperatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="TEMPERATURA"
            android:textColor="#455A64"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTemperatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="-- °C"
            android:textColor="#00695C"
            android:textSize="58sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHumedad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Humedad: -- %"
            android:textColor="#455A64"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#C8E6C9"
            android:gravity="center"
            android:padding="16dp"
            android:text="Esperando lectura del sensor"
            android:textColor="#1B5E20"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEstadoLed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="LED: sin confirmar"
            android:textColor="#455A64"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEncenderLed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="Encender LED"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnApagarLed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="Apagar LED"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnConsultarLed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="Consultar estado del LED"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="24dp"
            android:text="Ver historial"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="8dp"
            android:text="Cerrar sesión"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
